  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "make:migration": "npx sequelize-cli migration:generate --migrations-path migrations --name",
    "migrate:one": "npx sequelize-cli db:migrate --config config/config.js --migrations-path migrations --name",
    "migrate:all": "npx sequelize-cli db:migrate --config config/config.js --migrations-path migrations",
    "db:migrate": "npx sequelize-cli db:migrate --config config/config.js --migrations-path migrations",
    "migrate:rollback": "npx sequelize-cli db:migrate:undo:all --config config/config.js --migrations-path migrations",
    "migrate:rollback:one": "npx sequelize-cli db:migrate:undo --config config/config.js --migrations-path migrations --name",
    "make:seeder": "npx sequelize-cli seed:generate --seeders-path seeders --name",
    "db:seed": "npx sequelize-cli db:seed:all --config config/config.js --seeders-path seeders",
    "seed:one": "npx sequelize-cli db:seed --config config/config.js --seeders-path seeders --seed"
  },
